# GENERAL CONFIG
MESSAGES_LIMIT=15
PORT=3000
MOONIE_VERSION=v1

# Checkpointer (LangGraph). En el VPS: /var/lib/moonie/moonie.db
DB_PATH=./var/moonie.db

# Telegram (notificacion de reuniones agendadas)
BOT_TOKEN=
CHAT_ID=

# Google Calendar
GOOGLE_CALENDAR_ID=primary

# Credenciales de Langfuse 
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# GEMINI API KEY
GOOGLE_API_KEY=

# OAuth Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# LANGFUSE TRACING
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2="true"
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT="default"