{
  "name": "moonie",
  "version": "1.0.0",
  "description": "Asistente personal con agentes de código (LangChain / LangGraph / LangFuse) y API REST",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "tsx watch --inspect src/index.ts",
    "build": "tsc && tsc-alias && node scripts/postbuild.mjs",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/ollama": "^1.3.0",
    "@langfuse/client": "^5.9.1",
    "@langfuse/core": "^5.9.0",
    "@langfuse/langchain": "^5.9.0",
    "@langfuse/otel": "^5.9.1",
    "@opentelemetry/sdk-node": "^0.219.0",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "googleapis": "^173.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.19",
